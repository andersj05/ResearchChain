# Local development only; matches the loopback-only Compose database.
# Keep real credentials in .env or your environment, never in this file.
DATABASE_URL=postgresql://researchchain:researchchain-local@127.0.0.1:5433/researchchain
DATABASE_SCHEMA=public
# Tests create and remove their own unique schema; they do not clear app data.
TEST_DATABASE_URL=postgresql://researchchain:researchchain-local@127.0.0.1:5433/researchchain

# Exact workbench browser origin; keep services on loopback until deployment is approved.
RESEARCHCHAIN_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Optional protected owner-state root. Defaults to OS application data; never commit its contents.
# RESEARCHCHAIN_ACCESS_DIRECTORY=C:/private/researchchain-access
