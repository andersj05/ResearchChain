{
  "openapi": "3.1.0",
  "info": {
    "title": "ResearchChain API",
    "version": "0.2.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/node-types": {
      "get": {
        "summary": "Registered Types",
        "operationId": "node_types",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/NodeTypeSpec"
                  },
                  "type": "array",
                  "title": "Response Node Types"
                }
              }
            }
          }
        }
      }
    },
    "/api/workflows/validate": {
      "post": {
        "summary": "Validate",
        "operationId": "validate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Workflow"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/revisions": {
      "post": {
        "summary": "Save Revision",
        "operationId": "save_revision",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Workflow"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowRevision"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List Revisions",
        "operationId": "list_revisions",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RevisionSummary"
                  },
                  "title": "Response List Revisions"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/revisions/{revision_id}": {
      "get": {
        "summary": "Get Revision",
        "operationId": "get_revision",
        "parameters": [
          {
            "name": "revision_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Revision Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowRevision"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs": {
      "post": {
        "summary": "Start Run",
        "operationId": "start_run",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSnapshot"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List Runs",
        "operationId": "list_runs",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RunSummary"
                  },
                  "title": "Response List Runs"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}": {
      "get": {
        "summary": "Get Run",
        "operationId": "get_run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSnapshot"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/resume": {
      "post": {
        "summary": "Resume Run",
        "operationId": "resume_run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResumeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSnapshot"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/recover": {
      "post": {
        "summary": "Recover Run",
        "operationId": "recover_run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSnapshot"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/cancel": {
      "post": {
        "summary": "Cancel Run",
        "operationId": "cancel_run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArtifactRef": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$",
            "title": "Id"
          },
          "media_type": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Media Type"
          },
          "name": {
            "type": "string",
            "maxLength": 240,
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "media_type", "name"],
        "title": "ArtifactRef",
        "description": "Content address only. Upload/availability verification belongs to ingestion."
      },
      "CancelResult": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": ["cancelled", "completed", "rejected", "limited"],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "status"],
        "title": "CancelResult"
      },
      "ExecutionBudgets": {
        "properties": {
          "max_node_executions": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Max Node Executions",
            "default": 256
          },
          "max_active_seconds": {
            "type": "number",
            "maximum": 3600.0,
            "exclusiveMinimum": 0.0,
            "title": "Max Active Seconds",
            "default": 120
          },
          "max_concurrency": {
            "type": "integer",
            "maximum": 16.0,
            "minimum": 1.0,
            "title": "Max Concurrency",
            "default": 4
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ExecutionBudgets"
      },
      "ForkConfig": {
        "properties": {
          "type": {
            "type": "string",
            "const": "fork",
            "title": "Type",
            "default": "fork"
          },
          "join": {
            "type": "string",
            "title": "Join"
          },
          "branches": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 2,
            "title": "Branches"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["join", "branches"],
        "title": "ForkConfig"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "mode": {
            "type": "string",
            "const": "local-development",
            "title": "Mode",
            "default": "local-development"
          },
          "database": {
            "type": "string",
            "const": "ready",
            "title": "Database",
            "default": "ready"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Health"
      },
      "LoopConfig": {
        "properties": {
          "type": {
            "type": "string",
            "const": "loop",
            "title": "Type",
            "default": "loop"
          },
          "ref": {
            "$ref": "#/components/schemas/SubgraphRef"
          },
          "max_iterations": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Max Iterations"
          },
          "until": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Predicate"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["ref", "max_iterations"],
        "title": "LoopConfig"
      },
      "NodeTypeSpec": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["note", "review", "finish", "route", "fork", "join", "loop", "subgraph"],
            "title": "Kind"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/PortSpec"
            },
            "type": "array",
            "title": "Inputs"
          },
          "outputs": {
            "items": {
              "$ref": "#/components/schemas/PortSpec"
            },
            "type": "array",
            "title": "Outputs"
          },
          "config_schema": {
            "additionalProperties": true,
            "type": "object",
            "title": "Config Schema"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["kind", "label", "inputs", "outputs"],
        "title": "NodeTypeSpec"
      },
      "PortSpec": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "enum": ["control", "text", "number"],
            "title": "Type"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["name", "type"],
        "title": "PortSpec"
      },
      "Position": {
        "properties": {
          "x": {
            "type": "number",
            "maximum": 10000.0,
            "minimum": -10000.0,
            "title": "X"
          },
          "y": {
            "type": "number",
            "maximum": 10000.0,
            "minimum": -10000.0,
            "title": "Y"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["x", "y"],
        "title": "Position"
      },
      "Predicate": {
        "properties": {
          "left": {
            "$ref": "#/components/schemas/ValueSource"
          },
          "operator": {
            "type": "string",
            "enum": ["equals", "not_equals", "contains", "gt", "gte", "lt", "lte"],
            "title": "Operator"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "title": "Value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["left", "operator", "value"],
        "title": "Predicate"
      },
      "ResumeRequest": {
        "properties": {
          "checkpoint_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Checkpoint Id"
          },
          "interrupt_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Interrupt Id"
          },
          "decision": {
            "type": "string",
            "enum": ["approve", "reject"],
            "title": "Decision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["checkpoint_id", "interrupt_id", "decision"],
        "title": "ResumeRequest"
      },
      "ReviewPrompt": {
        "properties": {
          "interrupt_id": {
            "type": "string",
            "title": "Interrupt Id"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path"
          },
          "node_id": {
            "type": "string",
            "title": "Node Id"
          },
          "question": {
            "type": "string",
            "title": "Question"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["interrupt_id", "node_id", "question"],
        "title": "ReviewPrompt"
      },
      "RevisionSummary": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "content_hash": {
            "type": "string",
            "title": "Content Hash"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "number", "content_hash", "created_at", "name"],
        "title": "RevisionSummary"
      },
      "RouteConfig": {
        "properties": {
          "type": {
            "type": "string",
            "const": "route",
            "title": "Type",
            "default": "route"
          },
          "condition": {
            "$ref": "#/components/schemas/Predicate"
          },
          "join": {
            "type": "string",
            "title": "Join"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["condition", "join"],
        "title": "RouteConfig"
      },
      "RunEvent": {
        "properties": {
          "node_id": {
            "type": "string",
            "title": "Node Id"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "kind": {
            "type": "string",
            "enum": ["note", "review", "finish", "route", "fork", "join", "loop", "subgraph"],
            "title": "Kind"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["node_id", "label", "kind", "detail"],
        "title": "RunEvent"
      },
      "RunRequest": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "revision_id": {
            "type": "string",
            "format": "uuid",
            "title": "Revision Id"
          },
          "brief": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Brief"
          },
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/ArtifactRef"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Artifacts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "revision_id", "brief"],
        "title": "RunRequest"
      },
      "RunSnapshot": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "revision_id": {
            "type": "string",
            "format": "uuid",
            "title": "Revision Id"
          },
          "revision_number": {
            "type": "integer",
            "title": "Revision Number"
          },
          "workflow_name": {
            "type": "string",
            "title": "Workflow Name"
          },
          "status": {
            "type": "string",
            "enum": ["paused", "completed", "rejected", "interrupted", "cancelled", "limited"],
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "workflow": {
            "$ref": "#/components/schemas/Workflow"
          },
          "brief": {
            "type": "string",
            "title": "Brief"
          },
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/ArtifactRef"
            },
            "type": "array",
            "title": "Artifacts"
          },
          "compiler_version": {
            "type": "string",
            "title": "Compiler Version"
          },
          "checkpoint_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checkpoint Id"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/RunEvent"
            },
            "type": "array",
            "title": "Events"
          },
          "review": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReviewPrompt"
              },
              {
                "type": "null"
              }
            ]
          },
          "reviews": {
            "items": {
              "$ref": "#/components/schemas/ReviewPrompt"
            },
            "type": "array",
            "title": "Reviews"
          },
          "stop_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stop Reason"
          },
          "usage": {
            "$ref": "#/components/schemas/RunUsage"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "revision_id",
          "revision_number",
          "workflow_name",
          "status",
          "created_at",
          "workflow",
          "brief",
          "artifacts",
          "compiler_version",
          "checkpoint_id",
          "events"
        ],
        "title": "RunSnapshot"
      },
      "RunSummary": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "revision_id": {
            "type": "string",
            "format": "uuid",
            "title": "Revision Id"
          },
          "revision_number": {
            "type": "integer",
            "title": "Revision Number"
          },
          "workflow_name": {
            "type": "string",
            "title": "Workflow Name"
          },
          "status": {
            "type": "string",
            "enum": ["paused", "completed", "rejected", "interrupted", "cancelled", "limited"],
            "title": "Status"
          },
          "created_at": {
            "type": "string",
