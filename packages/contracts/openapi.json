{
  "openapi": "3.1.0",
  "info": {
    "title": "ResearchChain API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/workflows/validate": {
      "post": {
        "summary": "Validate",
        "operationId": "validate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Workflow"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs": {
      "post": {
        "summary": "Start Run",
        "operationId": "start_run",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSnapshot"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}": {
      "get": {
        "summary": "Get Run",
        "operationId": "get_run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSnapshot"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/resume": {
      "post": {
        "summary": "Resume Run",
        "operationId": "resume_run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResumeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSnapshot"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "mode": {
            "type": "string",
            "const": "local-development",
            "title": "Mode",
            "default": "local-development"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Health"
      },
      "Position": {
        "properties": {
          "x": {
            "type": "number",
            "maximum": 10000.0,
            "minimum": -10000.0,
            "title": "X"
          },
          "y": {
            "type": "number",
            "maximum": 10000.0,
            "minimum": -10000.0,
            "title": "Y"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["x", "y"],
        "title": "Position"
      },
      "ResumeRequest": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": ["approve", "reject"],
            "title": "Decision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["decision"],
        "title": "ResumeRequest"
      },
      "ReviewPrompt": {
        "properties": {
          "node_id": {
            "type": "string",
            "title": "Node Id"
          },
          "question": {
            "type": "string",
            "title": "Question"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["node_id", "question"],
        "title": "ReviewPrompt"
      },
      "RunEvent": {
        "properties": {
          "node_id": {
            "type": "string",
            "title": "Node Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "kind": {
            "type": "string",
            "enum": ["note", "review", "finish"],
            "title": "Kind"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["node_id", "label", "kind", "detail"],
        "title": "RunEvent"
      },
      "RunRequest": {
        "properties": {
          "workflow": {
            "$ref": "#/components/schemas/Workflow"
          },
          "brief": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Brief"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["workflow", "brief"],
        "title": "RunRequest"
      },
      "RunSnapshot": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "workflow": {
            "$ref": "#/components/schemas/Workflow"
          },
          "brief": {
            "type": "string",
            "title": "Brief"
          },
          "status": {
            "type": "string",
            "enum": ["paused", "completed", "rejected"],
            "title": "Status"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/RunEvent"
            },
            "type": "array",
            "title": "Events"
          },
          "review": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReviewPrompt"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "workflow", "brief", "status", "events"],
        "title": "RunSnapshot"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      },
      "ValidationResult": {
        "properties": {
          "valid": {
            "type": "boolean",
            "const": true,
            "title": "Valid",
            "default": true
          },
          "node_count": {
            "type": "integer",
            "title": "Node Count"
          },
          "workflow": {
            "$ref": "#/components/schemas/Workflow"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["node_count", "workflow"],
        "title": "ValidationResult"
      },
      "Workflow": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "0.1",
            "title": "Schema Version",
            "default": "0.1"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "start_node": {
            "type": "string",
            "title": "Start Node"
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/WorkflowNode"
            },
            "type": "array",
            "maxItems": 32,
            "minItems": 1,
            "title": "Nodes"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/WorkflowEdge"
            },
            "type": "array",
            "maxItems": 31,
            "title": "Edges"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["name", "start_node", "nodes", "edges"],
        "title": "Workflow"
      },
      "WorkflowEdge": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "target": {
            "type": "string",
            "title": "Target"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["source", "target"],
        "title": "WorkflowEdge"
      },
      "WorkflowNode": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": ["note", "review", "finish"],
            "title": "Kind"
          },
          "label": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Label"
          },
          "instructions": {
            "type": "string",
            "maxLength": 6000,
            "title": "Instructions",
            "default": ""
          },
          "position": {
            "$ref": "#/components/schemas/Position"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "kind", "label", "position"],
        "title": "WorkflowNode"
      }
    }
  }
}
